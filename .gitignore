# ============================================================
# Global .gitignore for finflow
# Java 21 + Spring Boot 4.x + Maven multi-service monorepo
# Services: account-service, api-gateway, fraud-detection-service,
#           notification-service, payment-service, transaction-service
# Infra: MySQL, Redis, Kafka, Zookeeper (docker-compose.yml)
# ============================================================

# ---------- Maven ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- Java / Spring Boot ----------
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
HELP.md
spring-shell.log

# Compiled / generated sources
.apt_generated/
.apt_generated_tests/
generated/
generated-sources/
generated-test-sources/

# Test / coverage output
surefire-reports/
failsafe-reports/
*.exec
jacoco.exec
jacoco/
.coverage/

# ---------- Application config / secrets ----------
# Local overrides - never commit real credentials
.env
*.env
!.env.example
!.env.sample
application-local.properties
application-local.yml
application-local.yaml
application-secret*.properties
application-secret*.yml
application-secret*.yaml
*/src/main/resources/application-local.*
*/src/main/resources/application-secret*
config/local/
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# ---------- Logs / temp ----------
*.log
*.log.*
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*
replay_pid*

# ---------- Docker ----------
.docker/
docker-compose.override.yml
docker-compose.local.yml
mysql-data/
data/
*.dump
*.sql.gz
dump.rdb

